# Rico Gateway Environment Configuration
RICO_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Redis URL for sliding window rate limiting (leave empty for in-memory fallback)
REDIS_URL=redis://localhost:6379/0

# Upstream Model Provider API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_URL=http://localhost:11434

# Gateway Auth Tokens
RICO_API_TOKENS=rico-dev-token,rico-prod-key-2026
